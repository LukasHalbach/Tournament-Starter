# Flask
SECRET_KEY=change-me-to-a-random-value
FLASK_DEBUG=1

# Database. Leave unset locally to use SQLite (instance/tournament.db).
# On Railway, set this to the Postgres connection string it provides.
DATABASE_URL=

# Admin login (Phase 1: single shared password, session-based)
ADMIN_PASSWORD=change-me

# File storage
# Local dev writes uploaded files under this folder.
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_SIZE_BYTES=1073741824

# Catalog
CATALOG_PATH=catalog.yaml
DEFAULT_COURSE_HOLES=18

# Notifications (Phase 2 — left unset means email is skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TSI_NOTIFY_EMAIL=
